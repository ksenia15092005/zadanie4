<Window x:Class="zadanie4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Анализатор частоты" Height="600" Width="900">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Открыть осциллограмму..." Click="OpenFile_Click"/>
                <Separator/>
                <MenuItem Header="_Выход" Click="Exit_Click"/>
            </MenuItem>
        </Menu>
        <ToolBar DockPanel.Dock="Top">
            <Button Click="OpenFile_Click">📂 Открыть CFG</Button>
            <Button Click="ZoomOut_Click">🔍 Сбросить масштаб</Button>
        </ToolBar>
        <TabControl>
            <TabItem Header="Осциллограмма">
                <ScottPlot:WpfPlot Name="OscilloscopePlot"/>
            </TabItem>
            <TabItem Header="Информация">
                <TextBox Name="InfoTextBox" IsReadOnly="True" TextWrapping="Wrap"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>